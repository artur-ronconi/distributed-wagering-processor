# Copy to .env for local development outside Docker (bun run dev).
PORT=3000
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
DATABASE_POOL_MAX=20
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WAGER_QUEUE_NAME=wager-transactions.fifo
WAGER_DLQ_NAME=wager-transactions-dlq.fifo
EVENTS_QUEUE_NAME=wagering-events.fifo
MIGRATIONS_RUN_ON_BOOT=true
RUN_HTTP=true
RUN_SQS_CONSUMER=true
RUN_OUTBOX_PUBLISHER=true
RUN_PENDING_REFERENCE_WORKER=true
LOG_LEVEL=info
