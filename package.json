{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor: wallets, ledger and wager transactions with idempotency, outbox and SQS",
  "type": "commonjs",
  "scripts": {
    "start": "docker compose up -d --build --wait",
    "destroy": "docker compose down --volumes --remove-orphans --rmi local",
    "console": "bun frontends/wallet-console/server.ts",
    "explorer": "bun frontends/flow-explorer/server.ts",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 120000",
    "test:concurrency": "bun test test/concurrency --timeout 300000",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "migration:up": "bun src/shared/infrastructure/database/migration.cli.ts up",
    "migration:down": "bun src/shared/infrastructure/database/migration.cli.ts down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1144.0",
    "@mikro-orm/core": "6.6.16",
    "@mikro-orm/migrations": "6.6.16",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.16",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "ddd-tool-kit": "2.3.0",
    "nestjs-pino": "4.6.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/bun": "1.4.2",
    "@types/express": "5.0.6",
    "typescript": "5.9.3"
  }
}
